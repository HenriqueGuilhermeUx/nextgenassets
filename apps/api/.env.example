# ============================================
# NextGen Assets — API Environment (TEMPLATE)
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real no Git
# ============================================

# ===== Banco de dados (Supabase / Railway) =====
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_HOST.supabase.co:5432/postgres?sslmode=require"

# ===== Redis (Upstash / Railway) =====
REDIS_URL="redis://default:SUA_SENHA@SEU_HOST.upstash.io:6379"

# ===== Aplicação =====
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WIDGET_URL=http://localhost:3005

# ===== CORS (separado por vírgula) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ===== JWT (gere valores fortes em produção) =====
JWT_SECRET=trocar-em-producao-min-32-chars
JWT_REFRESH_SECRET=trocar-em-producao-outro-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== OpenAI =====
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.7

# ===== Anthropic (fallback) =====
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== Efí Bank (Open Finance + ITP) =====
# Sandbox: https://api-hml.efi.com.br/v1
# Produção: https://api.efi.com.br/v1
EFI_API_URL=https://api-hml.efi.com.br/v1
EFI_CLIENT_ID=Client_Id_xxxxx
EFI_CLIENT_SECRET=Client_Secret_xxxxx
EFI_PIX_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFI_SANDBOX=true
# Certificado em base64 (gerar com: base64 -i cert.p12 | tr -d '\n')
EFI_CERTIFICATE_BASE64=

# ===== Woovi (Pix + Subcontas) =====
WOOVI_API_URL=https://api.woovi.com/v1
WOOVI_APP_ID=app_xxxxx
WOOVI_API_KEY=xxxxx
WOOVI_SANDBOX=true

# ===== NextGen Smart Operations =====
NEXTGEN_SMART_OPERATIONS_ENABLED=true
AV_DOCUMENT_PROVIDER=mock
AV_DOCUMENT_INTELLIGENCE_URL=https://av-document-intelligence.example.com
AV_DOCUMENT_INTELLIGENCE_TOKEN=token_xxxxx
NEXTGEN_PRODUCT_PROVIDER=mock
NEXTGEN_PRODUCT_SCAN_ENABLED=true
SMART_INBOX_SIGNED_URL_TTL_SECONDS=900

# ===== WhatsApp =====
# Providers: zapi | twilio | business_api | evolution
WHATSAPP_PROVIDER=zapi
WHATSAPP_API_URL=https://api.z-api.io
WHATSAPP_INSTANCE_ID=xxxxx
WHATSAPP_TOKEN=xxxxx

# ===== Vault (desenvolvimento) =====
VAULT_URL=http://localhost:8200
VAULT_TOKEN=orkest-dev-token

# ===== BullMQ =====
BULL_PREFIX=nga

# ===== Sentry (opcional) =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===== Observabilidade =====
LOG_LEVEL=debug

# ===== NextGen Pix Automático Efí — piloto somente em sandbox =====
# DESLIGADO por padrão; nunca habilitar produção sem homologação/segurança aprovada.
NEXTGEN_EFI_AUTOMATIC_ENABLED=false
NEXTGEN_EFI_AUTOMATIC_SANDBOX_REQUESTS=false
# Envio de ciclos Pix à sandbox: requer liberação adicional explícita
NEXTGEN_EFI_AUTOMATIC_SANDBOX_PAYMENTS=false
# Código IBGE do município recebedor, se exigido na requisição pela Efí
NEXTGEN_EFI_IBGE_CODE=
# Token exclusivo para endpoints ADMIN Efí (>=32 caracteres, definir só no Render)
NEXTGEN_ADMIN_TOKEN=SUBSTITUA_POR_VALOR_SEGURO_NO_RENDER
# Se configurar webhook Open Finance com segurança HMAC, reproduza a mesma chave na Efí
EFI_OF_WEBHOOK_HMAC=SUBSTITUA_POR_HMAC_FORTE_NO_RENDER
# Para testar consentimentos apenas com host openfinance-h em API e OAuth:
# EFI_OF_API_URL=https://openfinance-h.api.efipay.com.br
# EFI_OAUTH_URL=https://openfinance-h.api.efipay.com.br/v1/oauth/token
# EFI_OF_FAVORECIDO_NOME=...
# EFI_OF_FAVORECIDO_DOCUMENTO=...
# EFI_OF_FAVORECIDO_CODIGO_BANCO=...
# EFI_OF_FAVORECIDO_AGENCIA=...
# EFI_OF_FAVORECIDO_CONTA=...
# EFI_OF_FAVORECIDO_TIPO_CONTA=TRAN

# ===== NextGen recebimento centralizado / repasse D+1 (somente staging) =====
# NÃO habilitar até webhook bancário confirmado, banco de teste e validação contratual.
NEXTGEN_CENTRALIZED_D1_ENABLED=false
# Datas YYYY-MM-DD de feriados bancários, fornecidas por calendário bancário verificado;
# sem todas as datas/abrangência, a geração de repasse BLOQUEIA.
NEXTGEN_BANK_CALENDAR_SOURCE=VERIFIED_BANK_CALENDAR
NEXTGEN_BANK_CALENDAR_VERSION=SUBSTITUA_PELA_VERSAO_VALIDADA
NEXTGEN_BANK_CALENDAR_VERIFIED_THROUGH=YYYY-MM-DD
NEXTGEN_BANK_HOLIDAY_DATES=YYYY-MM-DD,YYYY-MM-DD

# Homologação isolada: desliga os workers legados que podem disparar Pix
NEXTGEN_DISABLE_BACKGROUND_WORKERS=false
