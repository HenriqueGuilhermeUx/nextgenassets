# Woovi environment template
# Copy these variables into your deployment provider and fill them there.
# Never commit real AppID, webhook secret, Pix key, client id, client secret, certificate or production token.

WOOVI_API_URL=https://api.woovi.com
WOOVI_APP_ID=<set-in-render-or-secret-manager>
WOOVI_FROM_PIX_KEY=<set-in-render-or-secret-manager>
WOOVI_WEBHOOK_SECRET=<set-in-render-or-secret-manager>
WOOVI_ENABLED=true

# NextGen Pix economics
NEXTGEN_PIX_COMMISSION_RATE=0
WOOVI_EXPECTED_FEE_CENTS=51

# Operational secrets
NEXTGEN_ADMIN_TOKEN=<set-in-render-or-secret-manager>
NEXTGEN_WOOVI_WEBHOOK_SECRET=<set-in-render-or-secret-manager>

# Keep direct withdraw disabled unless explicitly needed and protected.
# NEXTGEN_WITHDRAW_SECRET=<do-not-set-for-normal-pilot>
# NEXTGEN_WOOVI_WITHDRAW_SECRET=<do-not-set-for-normal-pilot>
